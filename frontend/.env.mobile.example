# Salin file ini menjadi .env.production dan ganti VITE_API_URL dengan URL backend HTTPS Anda
# sebelum melakukan build release Android (.aab) untuk Google Play Store.
#
# Setelah mengubah .env.production, jalankan dari folder frontend/:
#   npm run android:bundle
#
# Pastikan juga server backend menyertakan origin mobile pada CORS_ALLOWED_ORIGINS:
#   https://localhost,capacitor://localhost
VITE_API_URL=https://api.domain-anda.com/api/v1
